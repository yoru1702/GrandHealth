{
  "extends": "../../tsconfig.base.json",

  "compilerOptions": {
    "lib": [
      "dom",
      "dom.iterable",
      "esnext"
    ],

    "allowJs": true,

    "noEmit": true,

    "esModuleInterop": true,

    "jsx": "react-jsx",

    "incremental": true,

    "plugins": [
      {
        "name": "next"
      }
    ],

    "paths": {
      "@/*": [
        "./src/*"
      ],

      "@database-types/*": [
        "../../packages/database-types/*"
      ],

      "@shared/*": [
        "../../packages/shared/*"
      ],

      "@ui/*": [
        "../../packages/ui/*"
      ]
    }
  },

  "include": [
    "next-env.d.ts",
    "**/*.ts",
    "**/*.tsx",
    ".next/types/**/*.ts",
    ".next/dev/types/**/*.ts",
    "**/*.mts"
  ],

  "exclude": [
    "node_modules"
  ]
}